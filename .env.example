# 运行环境
NODE_ENV=development
PORT=3000

# ─── Supabase 配置（云端部署必填）───
# 从 Supabase Dashboard → Settings → API 获取
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key

# ─── 本地数据存储（不使用 Supabase 时生效）───
# DATA_DIR=./data
# UPLOAD_DIR=./data/uploads

# 会话配置
SESSION_TTL_MINUTES=480
QUERY_SESSION_TTL_MINUTES=30

# 文件上传限制
MAX_FILE_SIZE_MB=100
MAX_TOTAL_UPLOAD_MB=500

# 密钥 (生产环境必须配置，开发环境自动生成)
# REPORTER_DATA_KEY=base64编码的32字节随机密钥
# QUERY_CODE_PEPPER=base64编码的32字节随机密钥
# SESSION_SECRET=base64编码的32字节随机密钥

# 生产环境生成密钥示例:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
